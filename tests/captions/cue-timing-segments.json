    "cues": [
      {
        "start": 475.88395833333334,
        "end": 478.3211875,
        "text": "同一个价格，至少对应五个时刻。",
        "segment": "10"
      },
      {
        "start": 478.5468333333333,
        "end": 482.26472916666665,
        "text": "它先在市场上成交，供应商发布出来，我们采集回来，",
        "segment": "10"
      },
      {
        "start": 482.26472916666665,
        "end": 483.41322916666667,
        "text": "再写进数据库；",
        "segment": "10"
      },
      {
        "start": 483.41322916666667,
        "end": 486.33545833333335,
        "text": "最后，相关的人或系统第一次能取得它。",
        "segment": "10"
      },
      {
        "start": 486.65504166666665,
        "end": 489.01110416666666,
        "text": "这最后一个时刻，叫可用时间。",
        "segment": "10"
      },
      {
        "start": 489.32352083333336,
        "end": 493.75733333333335,
        "text": "它不是你今天查到的时间：今天查得到，不代表当时就查得到。",
        "segment": "10"
      },
      {
        "start": 493.9780416666667,
        "end": 497.3205625,
        "text": "所以，修订、补数和加工的历史都要留着，",
        "segment": "10"
      },
      {
        "start": 497.3205625,
        "end": 500.53056250000003,
        "text": "才说得清眼前这个值从何而来、何时可知。",
